[Desktop Entry]
Version=1.0
Type=Application
Name=FurryOS Mode Switcher
Comment=Switch between Granny, Normal, Gamer, Hacker, and Ghost modes
Icon=preferences-system
Exec=zenity --list --title="FurryOS Mode Switcher" --column="Mode" --column="Description" "Granny Mode" "Large fonts, accessible, beginner-friendly" "Normal Mode" "Balanced interface for everyday use" "Gamer Mode" "Gaming optimized with Steam and media tools" "Hacker Mode" "Development environment for coders and admins" "Ghost Mode" "Privacy & security focused with Tor and VPN"
Terminal=false
Categories=System;Settings;
X-Ubuntu-Gettext-Domain=furryos
StartupNotify=true
